// Prisma Schema for International Multi-Branch Spa Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  UPI
  ONLINE
  OTHER
}

enum MembershipStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
  COMPLETED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum VisitStatus {
  CHECKED_IN
  IN_SERVICE
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  CANCELLED
  REFUNDED
}

model Branch {
  id          String       @id @default(uuid())
  branchCode  String       @unique
  name        String
  country     String
  state       String?
  city        String
  address     String?
  phone       String?
  email       String?
  timezone    String       @default("Asia/Kolkata")
  currency    String       @default("INR")
  logo        String?
  openingTime String?
  closingTime String?
  status      BranchStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  users          User[]
  customers      Customer[]
  staff          Staff[]
  branchServices BranchService[]
  planTemplates  PlanTemplate[]
  memberships    Membership[]
  appointments   Appointment[]
  visits         Visit[]
  invoices       Invoice[]
  payments       Payment[]
  auditLogs      AuditLog[]
  customerNotes  CustomerNote[]
  notifications  Notification[]
  settings       Setting[]

  @@index([status])
  @@index([country])
  @@index([city])
  @@map("branches")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  branchId         String?
  isActive         Boolean   @default(true)
  lastLoginAt      DateTime?
  refreshTokenHash String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  branch          Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles       UserRole[]
  staffProfile    Staff?
  auditLogs       AuditLog[]
  createdPlans    PlanTemplate[]
  createdVisits   Visit[]
  createdPayments Payment[]
  notifications   Notification[]

  @@index([branchId])
  @@index([email])
  @@index([isActive])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  module      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Customer {
  id                String    @id @default(uuid())
  customerCode      String    @unique
  branchId          String
  firstName         String
  lastName          String?
  displayName       String
  phone             String
  email             String?
  gender            String?
  dateOfBirth       DateTime?
  nationality       String?
  address           String?
  city              String?
  country           String?
  emergencyContact  String?
  profileImage      String?
  notes             String?
  preferredLanguage String?
  status            String    @default("ACTIVE")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  branch        Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  memberships   Membership[]
  appointments  Appointment[]
  visits        Visit[]
  invoices      Invoice[]
  payments      Payment[]
  customerNotes CustomerNote[]
  documents     CustomerDocument[]

  @@index([branchId])
  @@index([phone])
  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@map("customers")
}

model Staff {
  id               String    @id @default(uuid())
  staffCode        String    @unique
  branchId         String
  userId           String?   @unique
  name             String
  phone            String?
  email            String?
  gender           String?
  dateOfBirth      DateTime?
  address          String?
  emergencyContact String?
  profileImage     String?
  position         String?
  specialization   String?
  joiningDate      DateTime?
  notes            String?
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments  Appointment[]
  visitServices VisitService[]

  @@index([branchId])
  @@index([status])
  @@index([name])
  @@map("staff")
}

model ServiceCategory {
  id           String   @id @default(uuid())
  name         String   @unique
  description  String?
  displayOrder Int      @default(0)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  services Service[]

  @@map("service_categories")
}

model Service {
  id              String    @id @default(uuid())
  code            String    @unique
  categoryId      String?
  name            String
  description     String?
  defaultDuration Int       @default(60) // in minutes
  defaultPrice    Decimal   @db.Decimal(12, 2)
  currency        String    @default("INR")
  status          String    @default("ACTIVE")
  image           String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  category             ServiceCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants             ServiceVariant[]
  branchServices       BranchService[]
  planTemplateServices PlanTemplateService[]
  membershipServices   MembershipService[]
  visitServices        VisitService[]
  Appointment          Appointment[]

  @@index([categoryId])
  @@index([status])
  @@index([name])
  @@map("services")
}

model ServiceVariant {
  id        String   @id @default(uuid())
  serviceId String
  name      String
  duration  Int      @default(60) // in minutes
  price     Decimal  @db.Decimal(12, 2)
  currency  String   @default("INR")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service              Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  planTemplateServices PlanTemplateService[]
  membershipServices   MembershipService[]
  visitServices        VisitService[]
  appointments         Appointment[]

  @@index([serviceId])
  @@map("service_variants")
}

model BranchService {
  id          String   @id @default(uuid())
  branchId    String
  serviceId   String
  customPrice Decimal? @db.Decimal(12, 2)
  currency    String   @default("INR")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([branchId, serviceId])
  @@index([branchId])
  @@index([serviceId])
  @@map("branch_services")
}

model PlanTemplate {
  id           String    @id @default(uuid())
  code         String    @unique
  branchId     String? // null = global template available across branches
  name         String
  description  String?
  durationDays Int       @default(30)
  price        Decimal   @db.Decimal(12, 2)
  currency     String    @default("INR")
  status       String    @default("ACTIVE")
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  branch      Branch?               @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  services    PlanTemplateService[]
  memberships Membership[]

  @@index([branchId])
  @@index([status])
  @@map("plan_templates")
}

model PlanTemplateService {
  id               String  @id @default(uuid())
  planTemplateId   String
  serviceId        String
  serviceVariantId String?
  quantity         Int     @default(1)

  planTemplate   PlanTemplate    @relation(fields: [planTemplateId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceVariant ServiceVariant? @relation(fields: [serviceVariantId], references: [id], onDelete: SetNull)

  @@index([planTemplateId])
  @@index([serviceId])
  @@map("plan_template_services")
}

model Membership {
  id             String           @id @default(uuid())
  membershipCode String           @unique
  customerId     String
  branchId       String
  planTemplateId String?
  isCustomPlan   Boolean          @default(false)
  name           String
  description    String?
  startDate      DateTime
  endDate        DateTime
  price          Decimal          @db.Decimal(12, 2)
  currency       String           @default("INR")
  discount       Decimal          @default(0) @db.Decimal(12, 2)
  tax            Decimal          @default(0) @db.Decimal(12, 2)
  finalAmount    Decimal          @db.Decimal(12, 2)
  paymentStatus  PaymentStatus    @default(PENDING)
  status         MembershipStatus @default(ACTIVE)
  notes          String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  customer     Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  planTemplate PlanTemplate?       @relation(fields: [planTemplateId], references: [id], onDelete: SetNull)
  services     MembershipService[]
  visits       Visit[]
  payments     Payment[]
  invoices     Invoice[]

  @@index([customerId])
  @@index([branchId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("memberships")
}

model MembershipService {
  id                String  @id @default(uuid())
  membershipId      String
  serviceId         String
  serviceVariantId  String?
  allocatedQuantity Int
  consumedQuantity  Int     @default(0)
  notes             String?

  membership     Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceVariant ServiceVariant? @relation(fields: [serviceVariantId], references: [id], onDelete: SetNull)
  visitServices  VisitService[]

  @@index([membershipId])
  @@index([serviceId])
  @@map("membership_services")
}

model Appointment {
  id               String            @id @default(uuid())
  appointmentCode  String            @unique
  branchId         String
  customerId       String
  serviceId        String
  serviceVariantId String?
  staffId          String?
  scheduledDate    DateTime
  startTime        String
  endTime          String
  status           AppointmentStatus @default(PENDING)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceVariant ServiceVariant? @relation(fields: [serviceVariantId], references: [id], onDelete: SetNull)
  staff          Staff?          @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([customerId])
  @@index([staffId])
  @@index([scheduledDate])
  @@index([status])
  @@map("appointments")
}

model Visit {
  id           String      @id @default(uuid())
  visitCode    String      @unique
  branchId     String
  customerId   String
  membershipId String?
  visitDate    DateTime    @default(now())
  checkInTime  DateTime    @default(now())
  checkOutTime DateTime?
  status       VisitStatus @default(CHECKED_IN)
  notes        String?
  createdById  String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  membership    Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  visitServices VisitService[]
  invoices      Invoice[]

  @@index([branchId])
  @@index([customerId])
  @@index([membershipId])
  @@index([visitDate])
  @@index([status])
  @@map("visits")
}

model VisitService {
  id                  String   @id @default(uuid())
  visitId             String
  membershipServiceId String?
  serviceId           String
  serviceVariantId    String?
  staffId             String?
  quantity            Int      @default(1)
  serviceNameSnapshot String
  variantNameSnapshot String?
  unitPriceSnapshot   Decimal  @db.Decimal(12, 2)
  currencySnapshot    String   @default("INR")
  status              String   @default("COMPLETED")
  notes               String?
  createdAt           DateTime @default(now())

  visit             Visit              @relation(fields: [visitId], references: [id], onDelete: Cascade)
  membershipService MembershipService? @relation(fields: [membershipServiceId], references: [id], onDelete: SetNull)
  service           Service            @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceVariant    ServiceVariant?    @relation(fields: [serviceVariantId], references: [id], onDelete: SetNull)
  staff             Staff?             @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([membershipServiceId])
  @@index([serviceId])
  @@index([staffId])
  @@map("visit_services")
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  branchId      String
  customerId    String
  membershipId  String?
  visitId       String?
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal       @db.Decimal(12, 2)
  currency      String        @default("INR")
  status        InvoiceStatus @default(ISSUED)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branch     Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  membership Membership?   @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  visit      Visit?        @relation(fields: [visitId], references: [id], onDelete: SetNull)
  items      InvoiceItem[]
  payments   Payment[]

  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id                String  @id @default(uuid())
  invoiceId         String
  description       String
  serviceId         String?
  quantity          Int     @default(1)
  unitPriceSnapshot Decimal @db.Decimal(12, 2)
  discount          Decimal @default(0) @db.Decimal(12, 2)
  tax               Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @db.Decimal(12, 2)
  currency          String  @default("INR")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid())
  paymentCode          String        @unique
  branchId             String
  customerId           String
  membershipId         String?
  invoiceId            String?
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @default("INR")
  paymentMethod        PaymentMethod @default(CASH)
  transactionReference String?
  paymentDate          DateTime      @default(now())
  status               PaymentStatus @default(PAID)
  notes                String?
  createdById          String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  branch     Branch      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  membership Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdBy  User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([customerId])
  @@index([membershipId])
  @@index([invoiceId])
  @@index([paymentDate])
  @@index([status])
  @@map("payments")
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  branchId   String
  authorId   String?
  authorName String
  note       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([branchId])
  @@map("customer_notes")
}

model CustomerDocument {
  id         String   @id @default(uuid())
  customerId String
  title      String
  fileUrl    String
  fileType   String
  fileSize   Int
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_documents")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String
  branchId   String?
  action     String
  entityType String
  entityId   String
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(uuid())
  branchId   String?
  userId     String?
  customerId String?
  type       String
  title      String
  message    String
  isRead     Boolean  @default(false)
  data       Json?
  createdAt  DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Setting {
  id          String   @id @default(uuid())
  branchId    String? // null = global system setting
  key         String
  value       Json
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@index([branchId])
  @@index([key])
  @@map("settings")
}
