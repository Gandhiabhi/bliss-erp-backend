# Copy this file to .env and replace every placeholder before starting the API.
#
# On the server, from this folder:
#   npm ci
#   npm run build
#   npm run db:setup
#   npm run start:prod
#
# npm ci installs the exact versions in package-lock.json.
# db:setup applies Prisma migrations, then seeds roles without deleting guests.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/blish_erp?schema=public"

PORT=4000
HOST=0.0.0.0
NODE_ENV=production

JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-another-long-random-string

# Browser addresses allowed to call this API. No trailing slash.
# Add another site after a comma:
# CORS_ORIGIN=https://spa.example.com,https://www.spa.example.com
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

STORAGE_PROVIDER=local
UPLOAD_DESTINATION=./uploads

# Used only by npm run db:seed. Required when NODE_ENV=production and the database has no users.
SEED_ADMIN_EMAIL=admin@your-spa.example
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ADMIN_FIRST_NAME=Admin
SEED_ADMIN_LAST_NAME=User
# SEED_RESET=true
