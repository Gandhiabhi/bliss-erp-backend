# ==============================================================================
# Blish Spa ERP - Backend Environment Variables
# ==============================================================================

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blish_erp?schema=public"

# Application Server Port & Environment
PORT=4000
NODE_ENV=production

# JWT Authentication Secrets & Expirations
JWT_SECRET=blish-super-secure-jwt-secret-key-2026-production-grade
JWT_REFRESH_SECRET=blish-super-secure-refresh-jwt-secret-key-2026-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=blish-secure-cookie-secret-signature-2026

# Allowed Frontend Origins (CORS & SameSite Cookies)
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# File Storage Configuration (local | s3 | r2)
STORAGE_PROVIDER=local
UPLOAD_DESTINATION=./uploads

# Optional Cloudflare R2 / AWS S3 Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
